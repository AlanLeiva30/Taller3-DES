@model GuardarPlazaDto
@{
    ViewData["Title"] = "Crear plaza";
    ViewData["Subtitulo"] = "Registre una nueva plaza. Quedará como borrador hasta que la publique.";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <form asp-action="CrearPlaza" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <partial name="_CamposPlaza" model="Model" />

            <div class="d-flex flex-wrap justify-content-end gap-2">
                <a class="btn btn-light" asp-action="Plazas">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i>Guardar plaza</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
