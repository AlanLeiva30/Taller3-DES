@model GuardarPlazaDto
@* Campos del formulario de plaza, compartidos por "Crear plaza" y "Editar plaza". *@
<div class="card mb-4">
    <div class="card-header"><h2><i class="bi bi-briefcase me-2 text-primary"></i>Información del puesto</h2></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ej.: Analista de Sistemas" />
                <span asp-validation-for="Titulo"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Institucion" class="form-label"></label>
                <input asp-for="Institucion" class="form-control" placeholder="Ej.: Ministerio de Hacienda" />
                <span asp-validation-for="Institucion"></span>
            </div>
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="8" placeholder="Funciones del puesto, requisitos, formación y experiencia solicitada..."></textarea>
                <span asp-validation-for="Descripcion"></span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h2><i class="bi bi-calendar-range me-2 text-primary"></i>Período de postulación</h2></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FechaPublicacion" class="form-label"></label>
                <input asp-for="FechaPublicacion" class="form-control" />
                <span asp-validation-for="FechaPublicacion"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FechaCierre" class="form-label"></label>
                <input asp-for="FechaCierre" class="form-control" />
                <span asp-validation-for="FechaCierre"></span>
            </div>
        </div>
        <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>La fecha de cierre debe ser posterior a la de publicación y no puede estar en el pasado.</div>
    </div>
</div>
