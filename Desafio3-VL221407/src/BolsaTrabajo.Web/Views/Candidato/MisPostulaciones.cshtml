@model ListadoPostulacionesViewModel
@{
    ViewData["Title"] = "Mis postulaciones";
    ViewData["Subtitulo"] = "Consulte el estado de cada proceso en el que participa.";
    ViewData["MostrarCandidato"] = false;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <partial name="_FiltrosPostulaciones" model="Model" />
    <a class="btn btn-primary" asp-controller="Plazas" asp-action="Index"><i class="bi bi-search"></i>Buscar más plazas</a>
</div>

<div class="card">
    @if (Model.Todas.Count == 0)
    {
        <partial name="_EstadoVacio" model='new EstadoVacioViewModel("bi-send", "Aún no se ha postulado", "Cuando se postule a una plaza, podrá seguir aquí su avance.", "Ver plazas disponibles", Url.Action("Index", "Plazas"))' />
    }
    else if (Model.Postulaciones.Count == 0)
    {
        <partial name="_EstadoVacio" model='new EstadoVacioViewModel("bi-funnel", "No hay postulaciones con este estado", "Seleccione otro filtro para ver el resto de sus postulaciones.")' />
    }
    else
    {
        <partial name="_TablaPostulaciones" model="Model.Postulaciones" view-data="ViewData" />
    }
</div>

<div class="card mt-4">
    <div class="card-body d-flex gap-3 flex-wrap small text-secondary">
        <span><span class="estado estado-revision">En revisión</span> El agente aún está evaluando su postulación.</span>
        <span><span class="estado estado-aprobada">Aprobada</span> Fue seleccionado(a) para continuar.</span>
        <span><span class="estado estado-rechazada">Rechazada</span> No fue seleccionado(a) en esta ocasión.</span>
    </div>
</div>
