@model MiPerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
    ViewData["Subtitulo"] = "Sus datos personales y su hoja de vida.";
    var hoja = Model.HojaDeVida;
}

<div class="row g-4">
    <div class="col-xl-5">
        <div class="card mb-4">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="avatar avatar-lg">@User.Iniciales()</span>
                <div style="min-width:0">
                    <div class="fw-bold fs-5 text-truncate">@Model.Usuario.NombreCompleto</div>
                    <div class="text-secondary small text-truncate">@Model.Usuario.Email</div>
                    <span class="rol @Presentacion.ClaseRol(Model.Usuario.Rol) mt-1"><i class="bi @Presentacion.IconoRol(Model.Usuario.Rol)"></i>@Model.Usuario.Rol</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h2>Datos personales</h2></div>
            <div class="card-body">
                <form asp-action="MiPerfil" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Formulario.NombreCompleto" class="form-label"></label>
                        <input asp-for="Formulario.NombreCompleto" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Formulario.NombreCompleto"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="correo">Correo electrónico</label>
                        <input id="correo" class="form-control" value="@Model.Usuario.Email" disabled />
                        <div class="form-text">El correo es su usuario de acceso y no se puede cambiar.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Formulario.Telefono" class="form-label"></label>
                        <input asp-for="Formulario.Telefono" class="form-control" placeholder="7777-8888" autocomplete="tel" />
                        <span asp-validation-for="Formulario.Telefono"></span>
                    </div>

                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Guardar cambios</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="card mb-4" id="hoja-de-vida">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2>Hoja de vida</h2>
                <span class="estado @(hoja is null ? "estado-revision" : "estado-aprobada")">@(hoja is null ? "Sin registrar" : "Registrada")</span>
            </div>
            <div class="card-body">
                @if (hoja is null)
                {
                    <p class="text-secondary small"><i class="bi bi-info-circle me-1"></i>Complete su información profesional. Los agentes de selección la verán cuando se postule a sus plazas.</p>
                }
                <form asp-action="GuardarHojaDeVida" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="FormularioHoja.FormacionAcademica" class="form-label"></label>
                        <textarea asp-for="FormularioHoja.FormacionAcademica" class="form-control" rows="4" placeholder="Ej.: Ingeniería en Sistemas Informáticos, Universidad..., 2020"></textarea>
                        <span asp-validation-for="FormularioHoja.FormacionAcademica"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FormularioHoja.ExperienciaLaboral" class="form-label"></label>
                        <textarea asp-for="FormularioHoja.ExperienciaLaboral" class="form-control" rows="4" placeholder="Puestos, instituciones o empresas, y años de experiencia"></textarea>
                        <span asp-validation-for="FormularioHoja.ExperienciaLaboral"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="FormularioHoja.Competencias" class="form-label"></label>
                        <textarea asp-for="FormularioHoja.Competencias" class="form-control" rows="3" placeholder="Ej.: trabajo en equipo, Excel avanzado, atención al público"></textarea>
                        <span asp-validation-for="FormularioHoja.Competencias"></span>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i>@(hoja is null ? "Registrar hoja de vida" : "Guardar cambios")</button>
                </form>
            </div>
        </div>

        <div class="card" id="cv">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2>CV en PDF</h2>
                @if (hoja?.TieneArchivoCV == true)
                {
                    <span class="estado estado-aprobada">Adjunto</span>
                }
            </div>
            <div class="card-body">
                @if (hoja is null)
                {
                    <div class="alert alert-info mb-0"><i class="bi bi-info-circle-fill"></i><div>Primero registre su hoja de vida; después podrá adjuntar su CV en PDF.</div></div>
                }
                else
                {
                    @if (hoja.TieneArchivoCV)
                    {
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-3" style="background:#f6f8f8;border:1px solid var(--bt-borde)">
                            <i class="bi bi-file-earmark-pdf-fill fs-2 text-danger"></i>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="fw-semibold text-break">@hoja.NombreArchivoCV</div>
                                <div class="small text-secondary">Archivo cargado</div>
                            </div>
                            <a class="btn btn-sm btn-outline-primary" asp-action="DescargarCv"><i class="bi bi-download"></i>Descargar</a>
                        </div>
                    }
                    <form asp-action="SubirCv" method="post" enctype="multipart/form-data">
                        <label for="archivo" class="form-label">@(hoja.TieneArchivoCV ? "Reemplazar por otro archivo" : "Seleccione su CV")</label>
                        <div class="input-group">
                            <input type="file" id="archivo" name="archivo" class="form-control" accept="application/pdf,.pdf" required data-nombre-destino="nombreElegido" />
                            <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i>Subir CV</button>
                        </div>
                        <div class="form-text"><i class="bi bi-info-circle me-1"></i>Solo archivos PDF, de máximo 5 MB. <span id="nombreElegido" class="fw-semibold"></span></div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
