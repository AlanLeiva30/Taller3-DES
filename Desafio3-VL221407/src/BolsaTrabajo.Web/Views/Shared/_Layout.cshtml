<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Bolsa de Trabajo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        var accion = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-publica sticky-top">
            <div class="container">
                <a class="navbar-brand marca" asp-controller="Home" asp-action="Index">
                    <span class="marca-icono">SV</span>
                    <span class="marca-texto">Bolsa de Trabajo<small>Servidores Públicos</small></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navegacionPublica"
                        aria-controls="navegacionPublica" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navegacionPublica">
                    <ul class="navbar-nav me-auto ms-lg-4 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Plazas" ? "active" : "")" asp-controller="Plazas" asp-action="Index">Plazas disponibles</a>
                        </li>
                    </ul>
                    <div class="d-flex flex-column flex-lg-row gap-2 my-3 my-lg-0">
                        <partial name="_BotonApi" />
                        <a class="btn btn-outline-primary @(accion == "Login" ? "active" : "")" asp-controller="Cuenta" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i>Iniciar sesión
                        </a>
                        <a class="btn btn-primary" asp-controller="Cuenta" asp-action="Registro">
                            <i class="bi bi-person-plus"></i>Crear cuenta
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @if (TempData.Peek("Exito") is not null || TempData.Peek("Error") is not null || TempData.Peek("Info") is not null)
        {
            <div class="container pt-3">
                <partial name="_Alertas" />
            </div>
        }
        @RenderBody()
    </main>

    <footer class="pie-publico">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <strong>Bolsa de Trabajo para Servidores Públicos</strong>
            <span>
                <a asp-controller="Plazas" asp-action="Index">Plazas disponibles</a> ·
                <a asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a> ·
                <a asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
            </span>
            <span>El Salvador · &copy; @DateTime.Now.Year</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
