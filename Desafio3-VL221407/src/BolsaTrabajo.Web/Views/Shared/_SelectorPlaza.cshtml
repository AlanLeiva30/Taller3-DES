@model ListadoPostulacionesViewModel
<form method="get" class="buscador mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-8 col-lg-6">
            <label for="plaza" class="form-label">Plaza</label>
            <select id="plaza" name="plaza" class="form-select" onchange="this.form.submit()">
                <option value="">Todas las plazas</option>
                @foreach (var p in Model.PlazasParaFiltro)
                {
                    <option value="@p.IdPlaza" selected="@(Model.IdPlazaFiltro == p.IdPlaza)">@p.Titulo (@p.TotalPostulaciones)</option>
                }
            </select>
        </div>
        @if (Model.EstadoFiltro is not null)
        {
            <input type="hidden" name="estado" value="@Model.EstadoFiltro" />
        }
        <div class="col-auto">
            <noscript><button type="submit" class="btn btn-primary">Filtrar</button></noscript>
            @if (Model.IdPlazaFiltro is not null)
            {
                <a class="btn btn-link" href="@Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), new { estado = Model.EstadoFiltro })"><i class="bi bi-x-circle"></i>Quitar filtro</a>
            }
        </div>
    </div>
</form>
