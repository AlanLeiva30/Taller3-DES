<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Bolsa de Trabajo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="panel-layout">
        <aside class="offcanvas-lg offcanvas-start barra-lateral" tabindex="-1" id="menuLateral" aria-label="Menú principal">
            <partial name="_MenuLateral" />
        </aside>

        <div class="panel-contenido">
            <header class="barra-superior">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-controls="menuLateral" aria-label="Abrir menú">
                    <i class="bi bi-list fs-5 m-0"></i>
                </button>

                <div class="flex-grow-1" style="min-width:0">
                    <h1 class="titulo-pagina">@ViewData["Title"]</h1>
                    @if (ViewData["Subtitulo"] is string subtitulo)
                    {
                        <p class="subtitulo-pagina">@subtitulo</p>
                    }
                </div>

                <partial name="_BotonApi" />

                <div class="dropdown">
                    <button class="btn usuario-boton" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opciones de la cuenta">
                        <span class="avatar">@User.Iniciales()</span>
                        <span class="d-none d-md-block text-start">
                            <span class="usuario-nombre">@User.NombreUsuario()</span>
                            <span class="usuario-rol">@User.Rol()</span>
                        </span>
                        <i class="bi bi-chevron-down small text-secondary d-none d-md-inline m-0"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="min-width: 15rem">
                        <li class="px-3 py-2">
                            <div class="fw-semibold">@User.NombreUsuario()</div>
                            <div class="small text-secondary">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Panel" asp-action="Index"><i class="bi bi-grid-1x2 me-2"></i>Mi panel</a></li>
                        @if (User.EsCandidato())
                        {
                            <li><a class="dropdown-item" asp-controller="Candidato" asp-action="MiPerfil"><i class="bi bi-person-circle me-2"></i>Mi perfil</a></li>
                        }
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main class="panel-cuerpo">
                <partial name="_Alertas" />
                @RenderBody()
            </main>

            <footer class="panel-pie">&copy; @DateTime.Now.Year Bolsa de Trabajo para Servidores Públicos</footer>
        </div>
    </div>

    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5 fw-bold" id="modalConfirmarTitulo">Confirmar acción</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body"><p class="mb-0" data-texto></p></div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" data-aceptar>Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
