@model List<PostulacionDto>
@{
    // Para el candidato no se muestra la columna "Candidato" (siempre es él mismo).
    var mostrarCandidato = ViewData["MostrarCandidato"] as bool? ?? true;
    // En la ficha de una plaza no hace falta repetir la columna "Plaza".
    var mostrarPlaza = ViewData["MostrarPlaza"] as bool? ?? true;
    // El Agente ve los botones para evaluar y consultar la hoja de vida.
    var evaluar = ViewData["Evaluar"] as bool? ?? false;
    var volverA = ViewData["VolverA"] as string ?? Context.Request.Path + Context.Request.QueryString;
}
<div class="table-responsive">
    <table class="table table-hover tabla">
        <thead>
            <tr>
                @if (mostrarCandidato)
                {
                    <th>Candidato</th>
                }
                @if (mostrarPlaza)
                {
                    <th>Plaza</th>
                }
                <th>Fecha de postulación</th>
                <th>Estado</th>
                @if (evaluar)
                {
                    <th class="text-end">Evaluación</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    @if (mostrarCandidato)
                    {
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@(p.NombreCandidato.Length > 0 ? p.NombreCandidato[..1].ToUpperInvariant() : "?")</span>
                                <div style="min-width:0">
                                    <div class="titulo-celda">@p.NombreCandidato</div>
                                    <div class="subtexto text-break">@p.EmailCandidato</div>
                                </div>
                            </div>
                        </td>
                    }
                    @if (mostrarPlaza)
                    {
                        <td>
                            <a class="titulo-celda" asp-controller="Plazas" asp-action="Detalle" asp-route-id="@p.IdPlaza">@p.TituloPlaza</a>
                            <div class="subtexto">@p.Institucion</div>
                        </td>
                    }
                    <td class="text-nowrap">@Presentacion.FechaCorta(p.FechaPostulacion)</td>
                    <td>
                        <span class="estado @Presentacion.ClaseEstadoPostulacion(p.Estado)">@Presentacion.Texto(p.Estado)</span>
                    </td>
                    @if (evaluar)
                    {
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-light" asp-controller="Agente" asp-action="HojaDeVida" asp-route-id="@p.IdCandidato" asp-route-plaza="@p.IdPlaza">
                                    <i class="bi bi-file-earmark-person"></i>Hoja de vida
                                </a>
                                @if (p.Estado != EstadoPostulacion.Aprobada)
                                {
                                    <form asp-controller="Agente" asp-action="Evaluar" asp-route-id="@p.IdPostulacion" method="post"
                                          data-confirmar="¿Aprobar la postulación de @p.NombreCandidato a «@p.TituloPlaza»?" data-confirmar-boton="Sí, aprobar" data-confirmar-estilo="success">
                                        <input type="hidden" name="resultado" value="@EstadoPostulacion.Aprobada" />
                                        <input type="hidden" name="volverA" value="@volverA" />
                                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i>Aprobar</button>
                                    </form>
                                }
                                @if (p.Estado != EstadoPostulacion.Rechazada)
                                {
                                    <form asp-controller="Agente" asp-action="Evaluar" asp-route-id="@p.IdPostulacion" method="post"
                                          data-confirmar="¿Rechazar la postulación de @p.NombreCandidato a «@p.TituloPlaza»?" data-confirmar-boton="Sí, rechazar" data-confirmar-estilo="danger">
                                        <input type="hidden" name="resultado" value="@EstadoPostulacion.Rechazada" />
                                        <input type="hidden" name="volverA" value="@volverA" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i>Rechazar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
