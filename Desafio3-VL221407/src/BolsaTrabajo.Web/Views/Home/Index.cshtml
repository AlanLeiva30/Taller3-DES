@model InicioViewModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="portada">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="eyebrow">Su talento, al servicio del país</span>
                <h1>Su próxima oportunidad<br />en el servicio público<br /><em>empieza aquí.</em></h1>
                <p class="lead mb-4">Consulte las plazas abiertas en instituciones públicas, postúlese en línea y dé seguimiento a cada etapa del proceso de selección.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary btn-lg" asp-controller="Plazas" asp-action="Index">Ver plazas disponibles ↗</a>
                    <a class="btn btn-outline-primary btn-lg" asp-controller="Cuenta" asp-action="Registro">Crear mi cuenta</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="portada-arte" aria-hidden="true">
                    <span class="portada-orbita"></span>
                    <div class="portada-tarjeta">
                        <span class="eyebrow">Plazas en el sector público</span>
                        <div class="d-flex gap-4 mt-3">
                            <div>
                                <div class="cifra">@(Model.ServicioDisponible ? Model.TotalPlazasAbiertas : "—")</div>
                                <div class="cifra-texto">Plazas abiertas</div>
                            </div>
                            <div>
                                <div class="cifra">@(Model.ServicioDisponible ? Model.TotalInstituciones : "—")</div>
                                <div class="cifra-texto">Instituciones</div>
                            </div>
                        </div>
                        <div class="portada-barras"><i></i><i></i><i></i><i></i></div>
                        <span>Personas + oportunidades</span>
                    </div>
                    <div class="portada-flotante">✦ Postulación 100 % en línea</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="seccion pt-0">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="eyebrow mb-2">Encuentre su lugar</span>
                <h2 class="seccion-titulo mb-1">Plazas que cierran pronto</h2>
                <p class="seccion-subtitulo mb-0">No deje pasar la fecha límite de postulación.</p>
            </div>
            <a class="btn btn-outline-primary" asp-controller="Plazas" asp-action="Index">Ver todas las plazas<i class="bi bi-arrow-right ms-2 me-0"></i></a>
        </div>

        @if (!Model.ServicioDisponible)
        {
            <div class="alert alert-warning"><i class="bi bi-cloud-slash"></i><div>En este momento no podemos mostrar las plazas. Intente de nuevo en unos minutos.</div></div>
        }
        else if (Model.PlazasDestacadas.Count == 0)
        {
            <div class="card">
                <partial name="_EstadoVacio" model='new EstadoVacioViewModel("bi-briefcase", "No hay plazas abiertas por ahora", "Vuelva pronto: las instituciones publican nuevas plazas con frecuencia.")' />
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var plaza in Model.PlazasDestacadas)
                {
                    <div class="col"><partial name="_TarjetaPlaza" model="plaza" /></div>
                }
            </div>
        }
    </div>
</section>

<section class="pb-4">
    <div class="container">
        <div class="row g-4 pasos">
            <div class="col-lg-4">
                <span class="eyebrow mb-2">¿Cómo funciona?</span>
                <h2 class="seccion-titulo h3">Su siguiente oportunidad,<br />en tres pasos.</h2>
            </div>
            <div class="col-md-4 col-lg paso">
                <span class="paso-numero">01</span>
                <h3>Cree su cuenta</h3>
                <p>Regístrese con su correo electrónico en menos de un minuto.</p>
            </div>
            <div class="col-md-4 col-lg paso">
                <span class="paso-numero">02</span>
                <h3>Complete su perfil</h3>
                <p>Registre su formación, experiencia y competencias, y adjunte su CV.</p>
            </div>
            <div class="col-md-4 col-lg paso">
                <span class="paso-numero">03</span>
                <h3>Postúlese y dé seguimiento</h3>
                <p>Envíe su postulación y consulte en todo momento en qué etapa se encuentra.</p>
            </div>
        </div>
    </div>
</section>
