@model AdminUsuariosViewModel
@{
    ViewData["Title"] = "Usuarios";
    ViewData["Subtitulo"] = "Personas registradas en el sistema, su rol y su gestión.";
    var total = Model.Roles.Sum(r => r.TotalUsuarios);
    var idActual = User.IdUsuario();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="filtros">
        <a class="filtro @(string.IsNullOrEmpty(Model.RolFiltro) ? "active" : "")" asp-action="Usuarios">
            Todos <span class="contador">@total</span>
        </a>
        @foreach (var rol in Model.Roles)
        {
            <a class="filtro @(Model.RolFiltro == rol.Nombre ? "active" : "")" asp-action="Usuarios" asp-route-rol="@rol.Nombre">
                @rol.Nombre <span class="contador">@rol.TotalUsuarios</span>
            </a>
        }
    </div>
    <a class="btn btn-primary" asp-action="CrearUsuario"><i class="bi bi-person-plus"></i>Crear usuario</a>
</div>

<div class="card">
    @if (Model.Usuarios.Count == 0)
    {
        <partial name="_EstadoVacio" model='new EstadoVacioViewModel("bi-people", "No hay usuarios con este rol", "Seleccione otro filtro para ver el resto de usuarios.")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover tabla">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo electrónico</th>
                        <th>Teléfono</th>
                        <th>Rol</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Usuarios)
                    {
                        var partes = u.NombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        var iniciales = partes.Length >= 2 ? $"{partes[0][0]}{partes[1][0]}" : partes.Length == 1 ? partes[0][..1] : "?";
                        var esUsted = u.Id == idActual;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar">@iniciales.ToUpperInvariant()</span>
                                    <div>
                                        <span class="titulo-celda">@u.NombreCompleto</span>
                                        @if (esUsted)
                                        {
                                            <div class="subtexto">Usted</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-break">@u.Email</td>
                            <td class="text-nowrap">@(string.IsNullOrWhiteSpace(u.Telefono) ? "—" : u.Telefono)</td>
                            <td><span class="rol @Presentacion.ClaseRol(u.Rol)"><i class="bi @Presentacion.IconoRol(u.Rol)"></i>@u.Rol</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-person-gear"></i>Cambiar rol
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li><h6 class="dropdown-header">Asignar el rol</h6></li>
                                            @foreach (var rol in Model.Roles.Where(r => r.Nombre != u.Rol))
                                            {
                                                <li>
                                                    <form asp-action="CambiarRol" asp-route-id="@u.Id" asp-route-filtro="@Model.RolFiltro" method="post"
                                                          data-confirmar="¿Asignar el rol «@rol.Nombre» a @u.NombreCompleto?" data-confirmar-boton="Sí, cambiar rol">
                                                        <input type="hidden" name="rol" value="@rol.Nombre" />
                                                        <button type="submit" class="dropdown-item"><i class="bi @Presentacion.IconoRol(rol.Nombre) me-2"></i>@rol.Nombre</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                    @if (!esUsted)
                                    {
                                        <form asp-action="EliminarUsuario" asp-route-id="@u.Id" asp-route-filtro="@Model.RolFiltro" method="post"
                                              data-confirmar="¿Eliminar la cuenta de @u.NombreCompleto? Esta acción no se puede deshacer."
                                              data-confirmar-boton="Sí, eliminar" data-confirmar-estilo="danger">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar usuario"><i class="bi bi-trash m-0"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
